# ─── Public (browser-safe) ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Use mock auth only (set false when ASP.NET Core is ready)
NEXT_PUBLIC_USE_MOCK=false

# Default tenant for multi-tenant backend (required on all protected calls)
NEXT_PUBLIC_TENANT_ID=demo-school-001
DEFAULT_TENANT_ID=demo-school-001

# ─── Server-only (Next.js Route Handlers / middleware) ───────────────
# Backend URL for BFF proxy — defaults to NEXT_PUBLIC_API_URL if unset
API_URL=http://localhost:5000/api

# ─── Production examples ─────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://app.yourschool.com
# NEXT_PUBLIC_API_URL=https://api.yourschool.com/api
# NEXT_PUBLIC_USE_MOCK=false
