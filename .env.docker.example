# Copy to .env.docker and adjust, then: docker compose --env-file .env.docker up --build

PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_USE_MOCK=true

# BFF proxy target (ASP.NET on host). Use host.docker.internal on Docker Desktop.
API_URL=http://host.docker.internal:5000/api
